{
  "name": "mailproof",
  "version": "1.4.0",
  "description": "Re-checkable proof of an email: the signed headers, never the body, recorded in a local git trail and verifiable offline forever. Two verdicts (live, portable), DKIM key archive, optional OpenTimestamps.",
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js'",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc",
    "prepublishOnly": "npm run build:types",
    "check:lockfile": "node scripts/check-lockfile.mjs"
  },
  "keywords": [
    "email",
    "dkim",
    "dmarc",
    "proof",
    "git",
    "audit-trail",
    "tamper-evident",
    "opentimestamps",
    "verification",
    "vanilla-js",
    "nodejs"
  ],
  "author": "hamr0 <avoidaccess@msn.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamr0/mailproof.git"
  },
  "bugs": {
    "url": "https://github.com/hamr0/mailproof/issues"
  },
  "homepage": "https://github.com/hamr0/mailproof#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "src/index.js",
    "src/proof/",
    "types/",
    "README.md",
    "mailproof.context.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "mailauth": "^8.0.4",
    "mailparser": "^3.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "undici": "^7.30.1",
    "nodemailer": "^10.3.1",
    "joi": "^18.3.1"
  }
}
